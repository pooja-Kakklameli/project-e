# Pin by digest in CI/Renovate: python:3.12.<patch>-slim-bookworm@sha256:<digest>
FROM python:3.12-slim-bookworm

# No .pyc writes (works with read-only rootfs); unbuffered stdout/stderr logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv/app

# Numeric UID so Kubernetes runAsNonRoot can verify it; no home dir, no login shell
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser

# Dependencies first: this layer is cached until requirements.txt changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Code is root-owned and read-only to the app user
COPY app/ ./app/

USER 10001
EXPOSE 8080

# Docker-only (Kubernetes ignores HEALTHCHECK; use liveness/readiness probes there)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"]

# Exec form: gunicorn is PID 1 and receives SIGTERM directly.
# gthread: the app is I/O bound (waits on GitHub), so threads beat 2 blocked sync workers.
# --worker-tmp-dir /dev/shm: gunicorn heartbeat files, needed for read-only rootfs.
# graceful-timeout < Kubernetes terminationGracePeriodSeconds (default 30s).
# Access log + error log to stdout/stderr (gunicorn's access log is off by default).
CMD ["gunicorn", "--bind", "0.0.0.0:8080", \
     "--worker-class", "gthread", "--workers", "2", "--threads", "4", \
     "--worker-tmp-dir", "/dev/shm", \
     "--timeout", "30", "--graceful-timeout", "25", \
     "--access-logfile", "-", "--error-logfile", "-", \
     "app.main:app"]